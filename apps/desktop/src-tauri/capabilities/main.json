{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: validated application commands and job event subscriptions only.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-inspect-media",
    "allow-enqueue-job",
    "allow-cancel-job",
    "allow-retry-job",
    "allow-update-settings",
    "allow-open-output"
  ]
}
